# 复制为 .env 后填写真实值；.env 不进 Git、不打包。
# 非密钥的运行参数请写在 config/settings.yaml 或 config/local/ 中。

# 大模型（OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=

# 商业数据源（可选，Windows 专用插件；未配置时系统照常运行）
COMMERCIAL_USERNAME=
COMMERCIAL_PASSWORD=

# 飞书自建应用机器人（首选通道）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书群自定义机器人（备用通道）
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# 可选第二数据源
TUSHARE_TOKEN=

# 日志级别（可选，默认 INFO）
# SA_LOG_LEVEL=INFO